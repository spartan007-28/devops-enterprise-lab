{
  "name": "devops-enterprise-lab",
  "version": "0.1.0",
  "private": true,
  "description": "TaskFlow enterprise DevOps learning platform",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/*"
  ],
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@taskflow/backend",
    "dev:frontend": "npm run dev --workspace=@taskflow/frontend",
    "dev:backend": "npm run dev --workspace=@taskflow/backend",
    "db:generate": "npm run prisma:generate --workspace=@taskflow/backend",
    "db:migrate": "npm run prisma:migrate:deploy --workspace=@taskflow/backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "typescript": "5.9.2"
  }
}
